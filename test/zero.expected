# Checks against the annotated listing mlir-opt writes to stderr.
#   plain line  -- this text must appear
#   !-prefixed  -- this text must NOT appear
#
# MLIR's printer renumbers SSA values, so pin each check to the operation text
# rather than to the names in zero.mlir.  Regenerate with ./run.sh after adding
# or reordering operations.

# --- rule 1: constants ----------------------------------------------------
llvm.mlir.constant(0 : i32) : i32 // %0 is zero
llvm.mlir.constant(1 : i32) : i32 // %1 is positive

# --- rule 2: `and` with a zero operand, and facts chaining through it ------
llvm.and %0, %arg0 : i32 // %2 is zero
llvm.and %arg0, %0 : i32 // %3 is zero
llvm.and %2, %arg0 : i32 // %4 is zero

# --- the solver joining facts at a block argument -------------------------
// argument: %2 is zero

# --- soundness: sign facts that are sound but imprecise ------------------
# %5 = 1 & 1 can't be `pos`, since 1 & 2 is 0; it is only known non-negative.
llvm.and %1, %1 : i32 // %5 is zero or positive
llvm.add %0, %0 : i32 // %7 is zero
llvm.and %arg0, %1 : i32 // %8 is zero or positive

# --- must stay unknown: `or` has no rule ----------------------------------
!%6 is
